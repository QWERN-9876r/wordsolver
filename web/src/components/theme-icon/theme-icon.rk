import styles from "./theme-icon.module.css"
import { Theme } from "../../theme/theme.rk"

// ThemeIcon draws a theme: a sun, a moon, or a half-filled circle for "auto".
export comp ThemeIcon(kind Theme) {
    if kind == "light" {
        return <svg class={styles.icon} viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
    }
    if kind == "dark" {
        return <svg class={styles.icon} viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />
        </svg>
    }
    return <svg class={styles.icon} viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="8.5" />
        <path class={styles.solid} d="M12 3.5a8.5 8.5 0 0 1 0 17z" />
    </svg>
}
